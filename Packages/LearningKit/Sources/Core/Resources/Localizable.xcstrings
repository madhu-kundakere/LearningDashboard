{
  "sourceLanguage": "en",
  "strings": {
    "error.decoding": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We received unexpected data. Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben unerwartete Daten erhalten. Bitte versuche es später erneut."
          }
        }
      }
    },
    "error.invalidCredentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect email or password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail oder Passwort ist falsch."
          }
        }
      }
    },
    "error.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find what you were looking for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt wurde nicht gefunden."
          }
        }
      }
    },
    "error.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Prüfe deine Verbindung und versuche es erneut."
          }
        }
      }
    },
    "error.persistence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved data couldn't be accessed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf gespeicherte Daten konnte nicht zugegriffen werden."
          }
        }
      }
    },
    "error.server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our servers are having trouble. Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere Server haben Probleme. Bitte versuche es später erneut."
          }
        }
      }
    },
    "error.unauthorized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please log in again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Bitte melde dich erneut an."
          }
        }
      }
    },
    "error.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        }
      }
    }
  },
  "version": "1.0"
}
