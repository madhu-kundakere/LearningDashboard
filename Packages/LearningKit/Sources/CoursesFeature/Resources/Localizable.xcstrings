    "courses.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Courses you enroll in will appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurse, für die du dich einschreibst, erscheinen hier."
          }
        }
      }
    },
